{
  "id": "cache-catcher",
  "name": "Cache Catcher",
  "description": "Monitor Claude Code cache health. Warns or blocks when cache writes exceed reads, indicating broken prompt caching.",
  "version": "0.6.4",
  "hooks": [
    "SessionStart",
    "UserPromptSubmit",
    "PostToolUse",
    "Stop"
  ],
  "category": "monitoring",
  "attribution": {
    "type": "original",
    "author": "Jacek Mariański",
    "license": "MIT",
    "url": "https://treetank.net"
  },
  "plugin": {
    "output": "cache-catcher"
  },
  "compatibility": {
    "claude": "native",
    "codex": "unsupported"
  }
}
